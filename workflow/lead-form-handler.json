    {
      "parameters": {
        "jsCode": "// Ответ Basic LLM Chain лежит в поле \"text\"\nconst raw = String($json.text ?? '');\n\nlet category = '';\nlet parseError = false;\n\ntry {\n  // убираем ```json ... ``` и вытаскиваем сам {...}\n  const clean = raw.replace(/```json|```/gi, '').trim();\n  const match = clean.match(/\\{[\\s\\S]*\\}/);\n  const parsed = JSON.parse(match ? match[0] : clean);\n  category = String(parsed.category ?? '').toLowerCase().trim();\n} catch (e) {\n  parseError = true;\n}\n\n// страховка: если модель выдала дичь -> warm\nif (!['hot', 'warm', 'cold'].includes(category)) {\n  category = 'warm';\n  parseError = true;\n}\n\n// заодно собираем данные клиента для Klaviyo\nconst c = $('Webhook').item.json.body.data.contact;\n\nreturn {\n  json: {\n    category,\n    parse_error: parseError,\n    email: c.email,\n    first_name: c.name?.first ?? '',\n    last_name: c.name?.last ?? '',\n    phone: c.phone ?? '',\n  },\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1248, -16],
      "id": "4f10ec14-2b72-45d5-99e4-989b217f9faa",
      "name": "Code in JavaScript"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Customer comment: \"\"\"{{ $('Webhook').item.json.body.data['field:form_field_039f'] || '' }}\"\"\"",
        "messages": {
          "messageValues": [
            {
              "message": "=You are a lead qualification assistant for Karline, a cake shop with delivery.\nYour only task is to classify an incoming lead based on the customer's comment. Do not reply to the customer and do not explain your choice.\n\nToday's date: {{ $now.setZone('Europe/Kyiv').toFormat('yyyy-MM-dd') }}\n\nCategories:\n- hot: ready to buy now or very soon. Signs: a specific date or deadline (today, tomorrow, this week, \"for Friday\", \"on the 15th\"), urgency (\"urgent\", \"asap\"), a concrete order (what + how many + when), a clear occasion with timing, or asking how to pay / for card details.\n- warm: interested in ordering but not ready yet. Signs: asks about flavors, sizes, prices, delivery area or options; describes a wish without a date or concrete details; needs more information or convincing.\n- cold: no real buying intent. Signs: general questions about the company or its history, partnership or job inquiries, spam, text unrelated to ordering, or an empty comment.\n\nRules:\n- If the comment contains at least one clear hot sign, choose hot, even if other signs are present.\n- If unsure between warm and cold, choose warm only when the comment mentions buying or ordering something.\n\nExamples:\n\"Need a chocolate cake for 2 people on Saturday, send card details\" -> {\"category\":\"hot\"}\n\"How much is a cake for 10 people? What flavors do you have?\" -> {\"category\":\"warm\"}\n\"Tell me about the history of your company\" -> {\"category\":\"cold\"}\n\nOutput: valid JSON only, no markdown, no extra text. The category must be lowercase and one of: hot, warm, cold.\nFormat: {\"category\":\"hot\"}"
            }
          ]
        },
        "batching": {}
      },
